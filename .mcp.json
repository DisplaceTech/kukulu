{
  "mcpServers": {
    "kukulu": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"],
      "env": {
        "KUKULU_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "KUKULU_CONFIG": "${KUKULU_CONFIG:-}",
        "KUKULU_PROFILE": "${KUKULU_PROFILE:-}",
        "FOUNDRY_CONFIG": "${FOUNDRY_CONFIG:-}",
        "FOUNDRY_PROFILE": "${FOUNDRY_PROFILE:-}"
      }
    }
  }
}
