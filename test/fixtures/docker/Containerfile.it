FROM node:22-bookworm-slim
ARG KUKULU_UID=1000
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && (userdel -r node 2>/dev/null || true) \
    && useradd --create-home --home-dir /home/kukulu --shell /bin/sh --uid ${KUKULU_UID} kukulu
USER kukulu
WORKDIR /home/kukulu
ENTRYPOINT ["node"]
